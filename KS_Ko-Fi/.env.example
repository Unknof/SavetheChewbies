# Ko-fi
KOFI_VERIFICATION_TOKEN=
KOFI_PROFILE_URL=https://ko-fi.com/YourName

# Discord (channel webhook URL, not a bot token)
DISCORD_WEBHOOK_URL=

# Server
PORT=8787

# Hardening (recommended for production)
# No surface interaction needed; keep UI off.
ENABLE_UI=0

# Require Ko-fi's verification token on every webhook.
REQUIRE_KOFI_TOKEN=1

# Max request size (bytes). Ko-fi payloads are tiny; this blocks junk.
MAX_REQUEST_BYTES=131072

# Tag strings supporters should paste into their Ko-fi message
TEAM_TAG=[TEAM]
PRIZE_TAG=[PRIZE]

# Afdian webhook
# No authentication token needed — Afdian identifies calls by the secret URL alone.
